# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# HostGator ops-checklist magnet (never commit the live Resend key or captured leads)
ops-checklist-magnet/config.php
ops-checklist-magnet/inbox/*.json
ops-checklist-magnet/inbox/*.jsonl

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
